{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "真实知识阅读 · 限制与恢复",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "content/assets/diagrams/reading-recovery.html"
  },
  "lanes": [
    {
      "id": "service",
      "label": "本机只读服务"
    },
    {
      "id": "recovery",
      "label": "受控恢复",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "locate",
      "lane": "service",
      "col": 0,
      "type": "backend",
      "label": "解析成员与绑定",
      "sublabel": "共同身份 / 本机位置",
      "width": 165,
      "yOffset": -60
    },
    {
      "id": "verify",
      "lane": "service",
      "col": 0,
      "type": "security",
      "label": "正文交付前复查",
      "sublabel": "位置代次 / 撤权 / 精确 SHA",
      "width": 190,
      "yOffset": 60
    },
    {
      "id": "deny",
      "lane": "recovery",
      "col": 2,
      "type": "security",
      "label": "拒绝失效或越权内容",
      "sublabel": "不回退旧正文",
      "width": 190
    },
    {
      "id": "review",
      "lane": "recovery",
      "col": 3,
      "type": "external",
      "label": "按原流程核查",
      "sublabel": "本机逐文件确认 / 修复绑定",
      "width": 190
    },
    {
      "id": "refresh",
      "lane": "recovery",
      "col": 4,
      "type": "backend",
      "label": "重新请求目录与正文",
      "sublabel": "授权不由 Web 自动扩大",
      "width": 190
    }
  ],
  "edges": [
    {
      "id": "verify-deny",
      "from": "verify",
      "to": "deny",
      "label": "变化 / 离线 / 撤权",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "locate-deny",
      "from": "locate",
      "to": "deny",
      "label": "位置无效",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "deny-review",
      "from": "deny",
      "to": "review",
      "label": "说明限制",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "review-refresh",
      "from": "review",
      "to": "refresh",
      "label": "明确确认后",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "refresh-locate",
      "from": "refresh",
      "to": "locate",
      "label": "重新解析",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "许可边界",
      "items": [
        "新文件不自动获得正文读取授权；SHA 变化不沿用旧字节授权。",
        "本文只描述本机阅读链，不代表生产写入或迁移授权。"
      ]
    }
  ]
}
